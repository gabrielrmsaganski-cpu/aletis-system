# ============================================================
# ALETIS — Environment variables (copiar para .env)
# ============================================================
# Quickstart local (sem credenciais externas):
#   cp .env.example .env && pnpm dev
# Em modo dev tudo funciona com dados mockados; integrações externas
# (WhatsApp, Azure Foundry, SICAR live, Resend) caem em DRY-RUN log.
#
# Produção: 4 variáveis OBRIGATÓRIAS (sem default seguro):
#   1. JWT_SECRET                 (gere com: openssl rand -hex 32)
#   2. CORS_ALLOWED_ORIGINS       (whitelist explícita)
#   3. DATABASE_URL               (Postgres 14+)
#   4. AZURE_AI_SERVICES_KEY      (cérebro ALIX; sem ela ALIX_USE_LLM=false)
# ============================================================


# ════════════════════════════════════════════════════════════
# 1. API SERVER (Fastify)
# ════════════════════════════════════════════════════════════
PORT=3011
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Whitelist de origins permitidos no CORS, separados por vírgula.
# Em produção é OBRIGATÓRIO setar — server lança erro no boot sem isso.
# Ex: https://app.aletis.com.br,https://aletis.com.br
CORS_ALLOWED_ORIGINS=

# Rate limit global (request/janela). Defaults seguros para uso interno.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# /metrics: por padrão só IPs privados (loopback + RFC1918 + tailscale 100.x)
# Setando METRICS_TOKEN, exige header Authorization: Bearer <token>
METRICS_TOKEN=


# ════════════════════════════════════════════════════════════
# 2. POSTGRES (persistência durável)
# ════════════════════════════════════════════════════════════
# DATABASE_URL: padrão libpq — host:porta/dbname?user&password
DATABASE_URL=postgres://aletis:aletis_dev_only@localhost:5432/aletis

# Quando "1", o backend persiste em PG (clientes, dossiês, propostas,
# financeiro, ALIX, BSC, etc). Quando "0", roda 100% em memória — útil
# pra testes locais sem subir PG.
ALETIS_PG_ENABLED=1

# Variáveis usadas pelo docker-compose (não pelo app diretamente):
POSTGRES_USER=aletis
POSTGRES_PASSWORD=aletis_dev_only
POSTGRES_DB=aletis
POSTGRES_PORT=5432
API_PORT=3011
WEB_PORT=5173
SITE_PORT=3000


# ════════════════════════════════════════════════════════════
# 3. JWT — Portal do Cliente
# ════════════════════════════════════════════════════════════
# Secret pra assinar os tokens do Portal. OBRIGATÓRIO em produção.
# Gerar: openssl rand -hex 32
JWT_SECRET=aletis-portal-dev-secret-change-me-in-prod


# ════════════════════════════════════════════════════════════
# 4. AZURE AI FOUNDRY — Cérebro ALIX (Claude Sonnet/Opus/Haiku)
# ════════════════════════════════════════════════════════════
# Authentication primária: DefaultAzureCredential (Managed Identity em
# prod, az CLI em dev). Fallback automático via header api-key se a
# env AZURE_AI_SERVICES_KEY estiver setada.
CLAUDE_FOUNDRY_BASE_URL=https://aletisai2.services.ai.azure.com
CLAUDE_FOUNDRY_API_VERSION=2024-10-21
AZURE_AI_SERVICES_KEY=

# IDs dos modelos no deployment Foundry — só altere se renomear no Azure
CLAUDE_MODEL_SONNET=claude-sonnet-4-6
CLAUDE_MODEL_HAIKU=claude-haiku-4-5
CLAUDE_MODEL_OPUS=claude-opus-4-7

# Override fino dos modelos por agente ALIX (default: Sonnet pra todos)
ALIX_ORCHESTRATOR_MODEL=claude-sonnet-4-6
ALIX_DEAL_ANALYZER_MODEL=claude-opus-4-7
ALIX_CRM_WRITER_MODEL=claude-sonnet-4-6
ALIX_DOC_GENERATOR_MODEL=claude-sonnet-4-6
ALIX_WEB_RESEARCHER_MODEL=claude-sonnet-4-6
ALIX_DOC_EXTRACTOR_MODEL=claude-haiku-4-5

# Set false pra desligar o cérebro LLM do ALIX (usa só regras/fallback)
ALIX_USE_LLM=true

# Sliding window do histórico ALIX por sessão (turnos retidos por chamada)
ALIX_HISTORY_WINDOW=30

# Alertas de custo Foundry (USD)
ALIX_COST_ALERT_USD_DAY=5
ALIX_COST_ALERT_USD_MONTH=50


# ════════════════════════════════════════════════════════════
# 5. WhatsApp Business Cloud API (Meta) — opcional
# ════════════════════════════════════════════════════════════
# Habilita: bot WhatsApp da ALIX + envio de magic-link para clientes.
# Crie um App em https://developers.facebook.com/apps (Business →
# WhatsApp). Pegue phone_number_id + Permanent System User Token.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=aletis-webhook-verify-change-me
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BUSINESS_ACCOUNT_ID=


# ════════════════════════════════════════════════════════════
# 6. Azure Speech (STT + TTS para áudios WhatsApp) — opcional
# ════════════════════════════════════════════════════════════
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_SPEECH_VOICE=pt-BR-FranciscaNeural
AZURE_SPEECH_FORMAT=ogg-24khz-16bit-mono-opus


# ════════════════════════════════════════════════════════════
# 7. PORTAL DO CLIENTE — base URL e storage
# ════════════════════════════════════════════════════════════
# URL pública do frontend (para magic-links, e-mails, OG image)
# Ex prod: https://app.aletis.com.br
ALETIS_PORTAL_BASE_URL=http://localhost:5173

# Diretório de uploads do cliente (cofre digital)
# Em Docker: mapeie volume nomeado para preservar ao redeploy.
ALETIS_PORTAL_UPLOAD_DIR=./storage/portal-uploads


# ════════════════════════════════════════════════════════════
# 8. SITE INSTITUCIONAL — leads + e-mail
# ════════════════════════════════════════════════════════════
# Cascata de fallback do POST /api/contato:
#   1) LEAD_WEBHOOK_URL (Slack/CRM/Make)
#   2) Resend (e-mail transacional)
#   3) JSONL local em storage/leads/

# Webhook que recebe POST {nome, email, ...} a cada lead
LEAD_WEBHOOK_URL=

# Resend (https://resend.com) — e-mail transacional
RESEND_API_KEY=
LEAD_EMAIL_TO=leads@aletis.com.br
LEAD_EMAIL_FROM=leads@aletis.com.br

# Storage local de leads como fallback
LEAD_STORAGE_DIR=./storage/leads


# ════════════════════════════════════════════════════════════
# 9. OBSERVABILIDADE (OpenTelemetry) — opcional
# ════════════════════════════════════════════════════════════
# Set 1 para habilitar traces auto-instrumentados (HTTP, pg, fastify).
OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=aletis-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production


# ════════════════════════════════════════════════════════════
# 10. INTEGRAÇÕES EXTERNAS — opcionais
# ════════════════════════════════════════════════════════════
# Tavily (web search para WebResearcher da ALIX)
# https://tavily.com — $5 free tier
TAVILY_API_KEY=

# Datajud (CNJ — consulta de processos para TJ tools)
# https://datajud-wiki.cnj.jus.br
DATAJUD_API_KEY=

# 2captcha (resolver captchas em SICAR live, Receita Federal)
# https://2captcha.com — $3 saldo cobre meses
TWOCAPTCHA_API_KEY=
TWOCAPTCHA_TIMEOUT_MS=120000
TWOCAPTCHA_POLL_INTERVAL_MS=5000


# ════════════════════════════════════════════════════════════
# 11. SICAR — prospecção agro (Cadastro Ambiental Rural)
# ════════════════════════════════════════════════════════════
# Shapefiles baixados via `pnpm download:sicar` (FTP/HTTP público).
# Necessita ~20GB para todas as UFs.
SICAR_DOWNLOAD_DIR=./storage/sicar/zip
SICAR_EXTRACT_DIR=./storage/sicar/shp
SICAR_UFS=SP,PR,RS,MG,MT,GO,MS,BA
SICAR_DOWNLOAD_URL_TEMPLATE=https://www.car.gov.br/publico/imoveis/downloads/{UF}_AREA_IMOVEL.zip
SICAR_SKIP_IF_RECENT_HOURS=24
SICAR_INSECURE_TLS=0


# ════════════════════════════════════════════════════════════
# 12. ESCALADA HUMANA (handoff)
# ════════════════════════════════════════════════════════════
# Exibido quando ALIX encaminha caso crítico para humano.
ALETIS_HANDOFF_NOME=Christian Kohler
ALETIS_HANDOFF_EMAIL=contato@aletis.com.br
ALETIS_HANDOFF_FONE=
