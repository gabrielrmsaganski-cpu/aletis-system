# ============================================================
# ALETIS — Environment variables (copiar para .env)
# ============================================================
# Quickstart local (sem credenciais externas):
#   cp .env.example .env && pnpm dev
# Em modo dev tudo funciona com dados mockados; integrações externas
# (WhatsApp, OpenAI, SICAR live, Resend) caem em DRY-RUN log.
#
# Produção: 4 variáveis OBRIGATÓRIAS (sem default seguro):
#   1. JWT_SECRET                 (gere com: openssl rand -hex 32)
#   2. CORS_ALLOWED_ORIGINS       (whitelist explícita)
#   3. DATABASE_URL               (Postgres 14+)
#   4. OPENAI_API_KEY             (cérebro ALIX e processamento inteligente)
# ============================================================


# ════════════════════════════════════════════════════════════
# 1. API SERVER (Fastify)
# ════════════════════════════════════════════════════════════
PORT=3011
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Whitelist de origins permitidos no CORS, separados por vírgula.
# Em produção é OBRIGATÓRIO setar — server lança erro no boot sem isso.
# Ex: https://app.aletis.com.br,https://aletis.com.br
CORS_ALLOWED_ORIGINS=

# Rate limit global (request/janela). Defaults seguros para uso interno.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# /metrics: por padrão só IPs privados (loopback + RFC1918 + tailscale 100.x)
# Setando METRICS_TOKEN, exige header Authorization: Bearer <token>
METRICS_TOKEN=


# ════════════════════════════════════════════════════════════
# 2. POSTGRES (persistência durável)
# ════════════════════════════════════════════════════════════
# DATABASE_URL: padrão libpq — host:porta/dbname?user&password
DATABASE_URL=postgres://aletis:REPLACE_WITH_YOUR_PASSWORD@localhost:5432/aletis

# Quando "1", o backend persiste em PG (clientes, dossiês, propostas,
# financeiro, ALIX, BSC, etc). Quando "0", roda 100% em memória — útil
# pra testes locais sem subir PG.
ALETIS_PG_ENABLED=1
# Sincronização automática das séries oficiais do módulo de recálculo.
RECALCULO_INDEX_SYNC_ENABLED=true

# Variáveis usadas pelo docker-compose (não pelo app diretamente):
POSTGRES_USER=aletis
POSTGRES_PASSWORD=
POSTGRES_DB=aletis
POSTGRES_PORT=5432
API_PORT=3011
WEB_PORT=5173
SITE_PORT=3000


# ════════════════════════════════════════════════════════════
# 3. JWT — Portal do Cliente
# ════════════════════════════════════════════════════════════
# Secret pra assinar os tokens do Portal. OBRIGATÓRIO em produção.
# Gerar: openssl rand -hex 32
JWT_SECRET=


# ════════════════════════════════════════════════════════════
# Login do ambiente interno (Christian, Regis e Eliandra).
# Gere o hash sem registrar a senha em texto aberto no arquivo:
# node -e "const c=require('node:crypto'),s=c.randomBytes(24),h=c.scryptSync(process.argv[1],s,64);console.log('scrypt$'+s.toString('base64url')+'$'+h.toString('base64url'))" 'SUA_SENHA'
ALETIS_INTERNAL_AUTH_ENABLED=1
ALETIS_AUTH_PASSWORD_HASH=
ALETIS_AUTH_RATE_LIMIT_MAX=8

# 4. OPENAI — Cérebro ALIX e inteligência documental
# ════════════════════════════════════════════════════════════
# A API conecta exclusivamente à plataforma OpenAI oficial. O endpoint é
# fixado no código para evitar troca acidental de provider.
ALIX_LLM_PROVIDER=openai
OPENAI_API_KEY=

# Política por função. Sol = análise profunda; Terra = equilíbrio;
# Luna = alto volume, classificação, resumo e extração simples.
ALIX_ORCHESTRATOR_MODEL=gpt-5.6-sol
ALIX_CHAT_MODEL=gpt-5.6-sol
ALIX_DEAL_ANALYZER_MODEL=gpt-5.6-sol
ALIX_ONBOARDING_DOSSIER_MODEL=gpt-5.6-sol
ALIX_CRM_WRITER_MODEL=gpt-5.6-terra
ALIX_CLIENT_INTELLIGENCE_MODEL=gpt-5.6-terra
ALIX_DOC_GENERATOR_MODEL=gpt-5.6-terra
ALIX_WEB_RESEARCHER_MODEL=gpt-5.6-terra
ALIX_DOC_ANALYZER_MODEL=gpt-5.6-sol
ALIX_DOC_EXTRACTOR_MODEL=gpt-5.6-luna
ALIX_DOC_CLASSIFIER_MODEL=gpt-5.6-luna
ALIX_SUMMARIZER_MODEL=gpt-5.6-luna
ALIX_MEMORY_MODEL=gpt-5.6-luna
ALIX_DEFAULT_MODEL=gpt-5.6-sol
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# Sal usado somente para hashes irreversíveis do conjunto dourado local.
ALIX_EVAL_ANONYMIZATION_SALT=
ALIX_EMBEDDING_BATCH_SIZE=64
# Atualização interna de dossiês disparada por fatos novos (fila durável).
# Mantenha 1 para versionar os dossiês de cada cliente de forma sequencial.
ALIX_DOSSIER_REFRESH_CONCURRENCY=1

# ── Streaming ──
ALIX_STREAMING_ENABLED=true

# Set false pra desligar o cérebro LLM do ALIX (usa só regras/fallback)
ALIX_USE_LLM=true

# Sliding window do histórico ALIX por sessão (turnos retidos por chamada)
ALIX_HISTORY_WINDOW=30
ALIX_MAX_TOOLS_PER_REQUEST=24
# PDFs são enviados como input_file nativo para leitura de texto + páginas visuais.
ALIX_NATIVE_FILE_INPUTS=true
ALIX_NATIVE_FILE_MAX_BYTES=20971520
ALIX_NATIVE_FILE_TOTAL_BYTES=31457280
ALIX_PDF_DETAIL=high
# Redige CPF/CNPJ, valores, percentuais e URLs sem evidência do turno.
ALIX_RESPONSE_GROUNDING=true
OPENAI_TIMEOUT_MS=120000
OPENAI_MAX_RETRIES=2

# Alertas de custo OpenAI (USD)
ALIX_COST_ALERT_USD_DAY=5
ALIX_COST_ALERT_USD_MONTH=50

# ── ALIX PROATIVA — agendamentos e push (Onda A+B) ───────────
# Liga/desliga toda a engine proativa (DOU, sócios, insights, briefing,
# regras de preço, weekly report).
ALIX_PROACTIVE_ENABLED=true
# Intervalos custom em ms (default: 24h DOU, 7d sócios, 1h insights, 30min regras)
# ALIX_PROACTIVE_DOU_MS=86400000
# ALIX_PROACTIVE_SOCIOS_MS=604800000
# ALIX_PROACTIVE_INSIGHTS_MS=3600000
# ALIX_PROACTIVE_RULES_MS=1800000
# Briefing diário ao amanhecer (default 07:07 local)
ALIX_BRIEFING_ENABLED=true
# Wave B3 — Weekly executive report (default seg 08:03 local)
ALIX_WEEKLY_REPORT_ENABLED=true
# ALIX_WEEKLY_REPORT_HOUR=8
# ALIX_WEEKLY_REPORT_MINUTE=3
# ALIX_WEEKLY_REPORT_DOW=1   # 0=dom, 1=seg, ..., 6=sab

# Wave B2 — Thresholds de macro-shift (em pontos-base ou %)
# MACRO_TH_SELIC_BP=50           # Δ Selic ≥ 50bp em 24h vira insight
# MACRO_TH_USD_PCT=3             # Δ USD/BRL ≥ 3% em 24h
# MACRO_TH_IPCA_BP=50            # Δ IPCA12m ≥ 50bp em 7d
# MACRO_TH_COMMODITY_PCT=5       # Δ commodity ≥ 5% em 7d

# ── PUSH ALIX → WhatsApp (Onda A: ativar push real) ───────────
# Sem ALIX_PROACTIVE_PUSH_WHATSAPP definido o canal cai em log-only
# (insights ficam só em storage/alix-push/YYYY-MM-DD.jsonl).
# Para Christian receber alertas, defina o número em E.164 (sem +):
ALIX_PROACTIVE_PUSH_WHATSAPP=
# Liga/desliga o canal sem precisar limpar o número:
ALIX_PUSH_ENABLED=true
# Modo seguro p/ dev: loga "como se enviasse" mas não chama Meta
ALIX_PUSH_DRYRUN=false
# Por padrão só urgência "crítico" dispara push. Set true para incluir
# urgência "importante" (stage-stuck, whatsapp-mudo, lead-quente).
ALIX_PUSH_ALLOW_IMPORTANTE=true


# ════════════════════════════════════════════════════════════
# 5. WhatsApp IA — Evolution API principal + Meta legado
# ════════════════════════════════════════════════════════════
# Provider ativo. Use "evolution" para a Central WhatsApp IA nova.
# "meta" mantém compatibilidade com a integração Cloud API anterior.
WHATSAPP_PROVIDER=evolution

# ── Evolution API v2 ────────────────────────────────────────
# Infra: docker compose -f docker-compose.whatsapp.yml up -d
# Manager: docker compose -f docker-compose.whatsapp.yml --profile manager up -d
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_PUBLIC_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-with-openssl-rand-hex-32
EVOLUTION_INSTANCE_NAME=aletis-principal
EVOLUTION_INSTANCE=aletis-principal
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3011/api/whatsapp/webhook
EVOLUTION_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_WEBHOOK_MAX_BYTES=2000000
EVOLUTION_WEBHOOK_BY_EVENTS=false
EVOLUTION_WEBHOOK_BASE64=true
EVOLUTION_API_PORT=8080
EVOLUTION_MANAGER_PORT=3008
EVOLUTION_MANAGER_PUBLIC_URL=
EVOLUTION_API_IMAGE=evoapicloud/evolution-api:latest
EVOLUTION_MANAGER_IMAGE=aletis/evolution-manager-v2:local

# Banco/cache dedicados da Evolution. Não reutilize o banco principal
# do ALETIS para as tabelas internas da Evolution.
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_POSTGRES_PORT=5434
EVOLUTION_REDIS_PORT=6380

# Storage de mídia/documentos. Em dev usa MinIO local; em prod pode
# trocar por S3/MinIO externo mantendo as mesmas credenciais.
WHATSAPP_STORAGE_PROVIDER=local
WHATSAPP_STORAGE_DIR=./storage/whatsapp-media
MINIO_ROOT_USER=aletis_minio
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
EVOLUTION_S3_ENABLED=true
EVOLUTION_S3_BUCKET=evolution

# IA conversacional e áudio do WhatsApp. Usa exclusivamente a OpenAI.
WHATSAPP_IA_ENABLED=true
WHATSAPP_IA_MODEL=gpt-5.6-luna
WHATSAPP_IA_DRY_RUN=false
WHATSAPP_AUDIO_REPLY_ENABLED=false
WHATSAPP_ELIGIBILITY_CONFIG_PATH=./config/whatsapp-eligibility.default.json
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=nova
OPENAI_TTS_FORMAT=opus

# Google Calendar do consultor Christian. Enquanto não conectar, deixe
# GOOGLE_CALENDAR_DRY_RUN=true para o sistema simular janelas de agenda.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_DRY_RUN=true
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Cuiaba
GOOGLE_CALENDAR_CONSULTOR_NAME=Christian
GOOGLE_CALENDAR_CONSULTOR_EMAIL=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_CREDENTIALS_PATH=
GOOGLE_OAUTH_ACCESS_TOKEN=

# ── WhatsApp Business Cloud API (Meta) — legado/opcional ─────
# Habilita o bot antigo da ALIX + envio de magic-link para clientes.
# Crie um App em https://developers.facebook.com/apps (Business →
# WhatsApp). Pegue phone_number_id + Permanent System User Token.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BUSINESS_ACCOUNT_ID=


# ════════════════════════════════════════════════════════════
# 6. PORTAL DO CLIENTE — base URL e storage
# ════════════════════════════════════════════════════════════
# URL pública do frontend (para magic-links, e-mails, OG image)
# Ex prod: https://app.aletis.com.br
ALETIS_PORTAL_BASE_URL=http://localhost:5173

# Diretório de uploads do cliente (cofre digital)
# Em Docker: mapeie volume nomeado para preservar ao redeploy.
ALETIS_PORTAL_UPLOAD_DIR=./storage/portal-uploads


# ════════════════════════════════════════════════════════════
# 8. SITE INSTITUCIONAL — leads + e-mail
# ════════════════════════════════════════════════════════════
# Cascata de fallback do POST /api/contato:
#   1) LEAD_WEBHOOK_URL (Slack/CRM/Make)
#   2) Resend (e-mail transacional)
#   3) JSONL local em storage/leads/

# Webhook que recebe POST {nome, email, ...} a cada lead
LEAD_WEBHOOK_URL=

# Resend (https://resend.com) — e-mail transacional
RESEND_API_KEY=
LEAD_EMAIL_TO=leads@aletis.com.br
LEAD_EMAIL_FROM=leads@aletis.com.br

# Storage local de leads como fallback
LEAD_STORAGE_DIR=./storage/leads


# ════════════════════════════════════════════════════════════
# 9. OBSERVABILIDADE (OpenTelemetry) — opcional
# ════════════════════════════════════════════════════════════
# Set 1 para habilitar traces auto-instrumentados (HTTP, pg, fastify).
OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=aletis-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production

# Langfuse via OpenTelemetry (opcional). Quando LANGFUSE_ENABLED=1,
# a API envia spans pelo @langfuse/otel em vez do exporter OTLP genérico.
LANGFUSE_ENABLED=0
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Guardrails anti-alucinação da ALIX para escrita documental no CRM.
ALIX_MIN_DOCUMENT_CONFIDENCE=0.65

# Docling parser opcional para PDFs/imagens/planilhas difíceis.
# Instalado neste servidor em /root/.cache/aletis-docling-venv/bin/docling.
ALIX_DOCLING_ENABLED=0
ALIX_DOCLING_BIN=/root/.cache/aletis-docling-venv/bin/docling
ALIX_DOCLING_DEVICE=cpu
ALIX_DOCLING_TIMEOUT_MS=120000


# ════════════════════════════════════════════════════════════
# 10. INTEGRAÇÕES EXTERNAS — opcionais
# ════════════════════════════════════════════════════════════
# Busca web nativa da Responses API, com fontes e citações.
ALIX_WEB_SEARCH_MODEL=gpt-5.6-terra

# Datajud (CNJ — consulta de processos para TJ tools)
# https://datajud-wiki.cnj.jus.br
DATAJUD_API_KEY=

# 2captcha (resolver captchas em SICAR live, Receita Federal)
# https://2captcha.com — $3 saldo cobre meses
TWOCAPTCHA_API_KEY=
TWOCAPTCHA_TIMEOUT_MS=120000
TWOCAPTCHA_POLL_INTERVAL_MS=5000


# ════════════════════════════════════════════════════════════
# 11. SICAR — prospecção agro (Cadastro Ambiental Rural)
# ════════════════════════════════════════════════════════════
# Shapefiles baixados via `pnpm download:sicar` (FTP/HTTP público).
# Necessita ~20GB para todas as UFs.
SICAR_DOWNLOAD_DIR=./storage/sicar/zip
SICAR_EXTRACT_DIR=./storage/sicar/shp
SICAR_UFS=SP,PR,RS,MG,MT,GO,MS,BA
SICAR_DOWNLOAD_URL_TEMPLATE=https://www.car.gov.br/publico/imoveis/downloads/{UF}_AREA_IMOVEL.zip
SICAR_SKIP_IF_RECENT_HOURS=24
SICAR_INSECURE_TLS=0


# ════════════════════════════════════════════════════════════
# 12. ESCALADA HUMANA (handoff)
# ════════════════════════════════════════════════════════════
# Exibido quando ALIX encaminha caso crítico para humano.
ALETIS_HANDOFF_NOME=Christian Kohler
ALETIS_HANDOFF_EMAIL=contato@aletis.com.br
ALETIS_HANDOFF_FONE=


# ════════════════════════════════════════════════════════════
# 14. ALETIS CORE IA — CRM, documentos e n8n
# ════════════════════════════════════════════════════════════
# Segurança interna. Em produção, ativar depois que login/RBAC real estiver
# implantado e permissões por cliente tiverem sido preenchidas.
ALETIS_RBAC_STRICT=false
ALETIS_CORE_DOCUMENT_DIR=./storage/core-documents
ALETIS_DOCUMENT_AUTO_INDEX=false
# Fila durável interna (pg-boss no mesmo PostgreSQL do ALETIS).
ALETIS_AI_QUEUE_ENABLED=true
ALETIS_AI_QUEUE_SCHEMA=pgboss
ALETIS_AI_QUEUE_POOL_MAX=4
ALIX_RAG_WORKER_CONCURRENCY=1
ALIX_FACT_WORKER_CONCURRENCY=2
ALIX_DEEP_ANALYSIS_CONCURRENCY=1
ALIX_DOCUMENT_PIPELINE_CONCURRENCY=1
# Backfill automático no boot é opt-in; o comando manual é:
# pnpm --filter @aletis/api knowledge:backfill
ALETIS_AI_BACKFILL_ON_START=false
# Usa a política central ALIX_CLIENT_INTELLIGENCE_MODEL da seção OpenAI.

# n8n para automações externas. A fila interna do ALETIS funciona
# mesmo com n8n desligado; habilite quando quiser disparar workflows.
N8N_AUTOMATION_ENABLED=false
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=
N8N_INBOUND_SECRET=
N8N_TIMEOUT_MS=8000


# ════════════════════════════════════════════════════════════
# 15. GOOGLE WORKSPACE — Drive, Docs, Calendar e Gmail
# ════════════════════════════════════════════════════════════
# Configure no Google Cloud Console:
# 1) OAuth consent screen
# 2) OAuth Client ID do tipo Web Application
# 3) Redirect URI: https://SEU_DOMINIO/api/integrations/google/callback
# 4) APIs: Google Drive, Google Docs, Google Calendar e Gmail API
GOOGLE_WORKSPACE_ENABLED=false
GOOGLE_DRIVE_SYNC_ENABLED=false
GOOGLE_DRIVE_GCLOUD_ACCOUNT=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_OAUTH_FRONTEND_URL=
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Cuiaba
GOOGLE_CALENDAR_CREATE_MEET=true
