# ============================================================
# ALETIS — Environment variables (copy to .env)
# ============================================================
# Fontes publicas (BCB, CEPEA via NoticiasAgricolas, INMET, IBGE,
# ANP, NASA FIRMS, OpenMeteo, AwesomeAPI, ComexStat) funcionam SEM
# nenhuma chave.
#
# Configurações deste arquivo:
#  • Obrigatórias em prod: JWT_SECRET
#  • Opcionais (habilitam recursos específicos):
#      - WHATSAPP_* → bot WhatsApp da Alix
#      - AZURE_SPEECH_* → STT/TTS para áudios no WhatsApp
#      - TWOCAPTCHA_API_KEY → resolver captchas em SICAR / Receita
#      - SICAR_* → prospecção agro via Cadastro Ambiental Rural
#
# Quickstart local: basta copiar este arquivo para .env e rodar
# `pnpm dev` — todas as features não-opcionais funcionam.
# ============================================================

# ── API server ─────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ── WhatsApp Business Cloud API (Meta) ─────────────────────
# Crie um App no Meta for Developers > Business > WhatsApp
# 1. https://developers.facebook.com/apps — novo app tipo "Business"
# 2. Adicione o produto "WhatsApp"
# 3. Em "API Setup": anote phone_number_id e o Temporary access token
# 4. Em "Configuration > Webhook": aponte pra
#    https://SEU_DOMINIO/api/whatsapp/webhook
#    com Verify Token = valor de WHATSAPP_VERIFY_TOKEN abaixo (qualquer string)
# 5. Subscribe aos eventos: messages, message_status, message_template_status_update
# 6. Para producao, gere um Permanent System User Token
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=aletis-webhook-verify-change-me
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Azure Speech (STT + TTS) ───────────────────────────────
# Portal Azure > Create resource > "Speech" (Cognitive Services)
# 1. Copie Key1 e Region (ex: brazilsouth, eastus)
# 2. Voz padrao: pt-BR-FranciscaNeural (feminina, assistant)
#    Alternativas: pt-BR-LeticiaNeural, pt-BR-YaraNeural, pt-BR-ThalitaMultilingualNeural
# 3. Formato otimo pra WhatsApp: ogg-24khz-16bit-mono-opus
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_SPEECH_VOICE=pt-BR-FranciscaNeural
AZURE_SPEECH_FORMAT=ogg-24khz-16bit-mono-opus

# ── Handoff (escalada humana) ──────────────────────────────
# Nome/contato do consultor exibido quando a Alix encaminha
# casos criticos (penhora, execucao, valor alto)
ALETIS_HANDOFF_NOME=Christian Kohler
ALETIS_HANDOFF_EMAIL=contato@aletis.com.br
ALETIS_HANDOFF_FONE=

# ── JWT — Portal do Cliente ────────────────────────────────
# Secret pra assinar os tokens do Portal do Cliente (cada cliente
# tem login/senha e acessa /portal). Em dev, o default é aceito mas
# em produção OBRIGATORIAMENTE troque por uma string forte (32+ chars)
# Gerar: `openssl rand -hex 32`
JWT_SECRET=aletis-portal-dev-secret-change-me-in-prod

# ── 2captcha — Captcha solver genérico ─────────────────────
# Usado pra SICAR (hCaptcha/Turnstile), Receita Federal, e sites que
# protegem dados públicos com captcha. Sem isso, ingest:sicar e
# algumas fontes entram em fallback.
# Conta: https://2captcha.com/ (saldo inicial $3 cobre meses de uso)
# Custo: Turnstile ~$1.45/1000, hCaptcha ~$2/1000, imagem ~$0.50/1000
TWOCAPTCHA_API_KEY=
TWOCAPTCHA_TIMEOUT_MS=120000
TWOCAPTCHA_POLL_INTERVAL_MS=5000

# ── SICAR — Cadastro Ambiental Rural (prospecção agro) ─────
# Os shapefiles SICAR por UF são baixados pelo script `pnpm download:sicar`
# e indexados automaticamente. Não é API — é FTP/HTTP público do governo.
# Diretórios onde os .zip baixados e os .shp extraídos ficam no disco.
# Recomendado: criar fora do repo (requer ~20GB para todas as UFs).
SICAR_DOWNLOAD_DIR=./storage/sicar/zip
SICAR_EXTRACT_DIR=./storage/sicar/shp
# UFs que o download:sicar vai baixar (separadas por vírgula)
SICAR_UFS=SP,PR,RS,MG,MT,GO,MS,BA
# Template da URL — substitui {UF} pela sigla em maiúsculo
SICAR_DOWNLOAD_URL_TEMPLATE=https://www.car.gov.br/publico/imoveis/downloads/{UF}_AREA_IMOVEL.zip
# Pular download se já existe arquivo com menos de X horas (0 = sempre baixa)
SICAR_SKIP_IF_RECENT_HOURS=24
# Em alguns ambientes corporativos o TLS do CAR falha — set 1 pra ignorar
SICAR_INSECURE_TLS=0
