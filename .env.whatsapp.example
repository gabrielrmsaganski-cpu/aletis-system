# ============================================================
# ALETIS — WhatsApp IA API / Evolution API
# Copie ou mantenha junto do .env principal.
# ============================================================

WHATSAPP_PROVIDER=evolution
WHATSAPP_PUBLIC_BASE_URL=http://localhost:3011
WHATSAPP_WEBHOOK_SECRET=change-me-with-openssl-rand-hex-32
WHATSAPP_WEBHOOK_MAX_BYTES=2000000

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_PUBLIC_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me-with-openssl-rand-hex-32
EVOLUTION_INSTANCE_NAME=aletis-principal
EVOLUTION_INSTANCE=aletis-principal
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3011/api/whatsapp/webhook
EVOLUTION_WEBHOOK_SECRET=${WHATSAPP_WEBHOOK_SECRET}
EVOLUTION_MANAGER_URL=http://localhost:3008
EVOLUTION_MANAGER_PUBLIC_URL=
EVOLUTION_API_PORT=8080
EVOLUTION_MANAGER_PORT=3008
EVOLUTION_API_IMAGE=evoapicloud/evolution-api:latest
EVOLUTION_MANAGER_IMAGE=aletis/evolution-manager-v2:local
EVOLUTION_WEBHOOK_BY_EVENTS=false
EVOLUTION_WEBHOOK_BASE64=true

EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_POSTGRES_PORT=5434
EVOLUTION_REDIS_PORT=6380

DOCUMENT_STORAGE_PROVIDER=local
WHATSAPP_STORAGE_PROVIDER=local
WHATSAPP_STORAGE_DIR=./storage/whatsapp-media
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=aletis_minio
MINIO_SECRET_KEY=
MINIO_BUCKET=evolution
MINIO_ROOT_USER=aletis_minio
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
EVOLUTION_S3_ENABLED=true
EVOLUTION_S3_BUCKET=evolution

WHATSAPP_IA_ENABLED=true
WHATSAPP_IA_MODEL=gpt-5.4-mini
WHATSAPP_AUDIO_REPLY_ENABLED=false
WHATSAPP_ELIGIBILITY_CONFIG_PATH=./config/whatsapp-eligibility.default.json

AUDIO_TRANSCRIPTION_PROVIDER=azure
AUDIO_TTS_PROVIDER=azure
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_SPEECH_VOICE=pt-BR-FranciscaNeural
AZURE_SPEECH_FORMAT=ogg-24khz-16bit-mono-opus
OPENAI_API_KEY=
OPENAI_AUDIO_TRANSCRIPTION_URL=
OPENAI_WHISPER_MODEL=whisper-1

GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_DRY_RUN=true
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Cuiaba
GOOGLE_CALENDAR_CONSULTOR_NAME=Christian
GOOGLE_CALENDAR_CONSULTOR_EMAIL=
GOOGLE_CALENDAR_CREDENTIALS_PATH=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH_ACCESS_TOKEN=
