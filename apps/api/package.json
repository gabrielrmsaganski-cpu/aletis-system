{
  "name": "@aletis/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc && pnpm run build:copy-assets",
    "build:copy-assets": "mkdir -p dist/db/migrations && cp -r src/db/migrations/. dist/db/migrations/ 2>/dev/null || true",
    "start": "node --env-file=../../.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "eval:alix:reliability": "tsx scripts/eval-alix-reliability.ts",
    "eval:alix:golden": "tsx scripts/eval-alix-golden.ts",
    "eval:alix:governance": "tsx scripts/eval-alix-governance.ts",
    "eval:alix:promptfoo": "promptfoo eval -c evals/alix/promptfooconfig.yaml --no-progress-bar",
    "build:alix:golden": "tsx --env-file=../../.env scripts/build-alix-golden-set.ts",
    "build:alix:golden:persist": "tsx --env-file=../../.env scripts/build-alix-golden-set.ts --persist",
    "knowledge:backfill": "tsx --env-file=../../.env scripts/backfill-alix-knowledge.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env scripts/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "migrate:leads": "tsx --env-file=../../.env scripts/migrate-leads-to-pg.ts",
    "migrate:storage": "tsx --env-file=../../.env scripts/migrate-storage-to-pg.ts",
    "build:processo-templates": "tsx scripts/build-processo-assessoria-templates.ts",
    "ingest:pgfn": "tsx scripts/ingest-pgfn.ts",
    "ingest:pgfn:light": "python3 scripts/ingest-pgfn-light.py --input /tmp/pgfn/extracted --output storage/prospeccao",
    "ingest:sicar": "tsx scripts/ingest-sicar.ts",
    "ingest:dou": "tsx --env-file=../../.env scripts/ingest-dou.ts",
    "ingest:socios": "tsx --env-file=../../.env scripts/ingest-socios.ts",
    "import:client-documents": "tsx scripts/import-client-document-packages.ts",
    "download:sicar": "tsx --env-file=../../.env scripts/download-sicar.ts",
    "refresh:sicar": "tsx --env-file=../../.env scripts/refresh-sicar.ts"
  },
  "dependencies": {
    "@aletis/brand": "workspace:*",
    "@aletis/contabil-calc": "workspace:*",
    "@aletis/financial-calc": "workspace:*",
    "@aletis/knowledge-base": "workspace:*",
    "@aletis/shared-types": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.1.0",
    "@langfuse/otel": "5.3.0",
    "@mozilla/readability": "^0.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.73.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.215.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-node": "^0.215.0",
    "@opentelemetry/sdk-trace-base": "^2.7.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "axios": "^1.7.9",
    "axios-retry": "^4.5.0",
    "cheerio": "^1.0.0",
    "decimal.js": "^10.6.0",
    "docx": "^9.0.0",
    "docxtemplater": "^3.68.6",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "fastify-metrics": "^13.2.0",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "node-cache": "^5.1.2",
    "openai": "^7.5.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.20.0",
    "pg-boss": "12.27.0",
    "pizzip": "^3.2.0",
    "pptxgenjs": "^4.0.1",
    "puppeteer": "^24.2.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sharp": "^0.33.5",
    "unpdf": "1.4.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  }
}
