.vite-temp/

# Runtime state (session history persisted per user)
apps/api/storage/alix-sessions/
apps/api/storage/whatsapp-sessions/
apps/api/storage/whatsapp-alix-sessions/

# Prospecção runtime data (regenerated by ingest scripts)
apps/api/storage/prospeccao/leads-agro.json
apps/api/storage/prospeccao/leads-agro-summary.json
apps/api/storage/prospeccao/sicar-imoveis.json
apps/api/storage/prospeccao/enriched/
apps/api/storage/prospeccao/blacklist.json
apps/api/storage/prospeccao/queue.json
apps/api/storage/prospeccao/sources.json

# Financeiro runtime data (db.json + anexos + fechamentos gerados)
apps/api/storage/financeiro/

# Cliente Inteligente — snapshots de análises automáticas (regeneráveis)
apps/api/storage/clientes/

# Planos de Custeio Agrícola (Wave 4a)
apps/api/storage/custeio/

# BSC snapshots append-only por cliente (Wave 8a)
apps/api/storage/bsc/*.jsonl

# Wave 9 — runtime state da Alix (intake, outputs gerados, memória por cliente)
apps/api/storage/alix-documents/*/
apps/api/storage/alix-outputs/*/
apps/api/storage/alix-memory/*.md
!apps/api/storage/alix-documents/.gitkeep
!apps/api/storage/alix-outputs/.gitkeep
!apps/api/storage/alix-memory/.gitkeep

# Wave 9b — runtime state adicional ALIX (insights diários, push, feedback,
# confirmations, contatos, surfaced state)
apps/api/storage/alix-confirmations/
apps/api/storage/alix-feedback/
apps/api/storage/alix-insights/*.jsonl
apps/api/storage/alix-push/
apps/api/storage/inventario/
apps/api/storage/.surfaced.json
apps/api/storage/prospeccao/contatos.json
apps/api/storage/prospeccao/dou-leads.json

# Auditoria interna (relatórios + screenshots gerados pelo sistema)
aletis-audit/

# Drizzle cache local
.drizzle/

# Coverage HTML (Vitest)
coverage/

# Playwright artifacts
playwright-report/
test-results/
.playwright-mcp/
.playwright-cli/

