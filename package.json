{
  "name": "aletis-system",
  "version": "0.1.0",
  "private": true,
  "description": "ALETIS — Finanças Estratégicas & Agrobusiness Platform",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "dev:web": "pnpm --filter @aletis/web dev",
    "dev:api": "pnpm --filter @aletis/api dev",
    "typecheck": "pnpm -r run typecheck"
  }
}
